{
  "name": "toggl-traction",
  "version": "0.1.9",
  "description": "An accessible, cross-platform time tracker that talks to Toggl Track",
  "main": "./out/main/index.js",
  "author": "Toggl Traction",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielroy96/toggl-traction.git"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "test": "node scripts/run-tests.mjs",
    "dev:server": "node scripts/run-dev-server.mjs",
    "dev:web": "vite --config vite.preview.config.ts",
    "make:icon": "node scripts/make-icon.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "npm run typecheck && npm run check:contrast && npm run test && npm run build"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.toggltraction.app",
    "productName": "Toggl Traction",
    "afterPack": "build/afterPack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Toggl Traction"
    },
    "publish": {
      "provider": "github"
    }
  },
  "allowScripts": {
    "electron@44.1.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": false
  }
}
